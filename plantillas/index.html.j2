{#- Plantilla de la página de resultados.
    Regla: ningún número se escribe a mano; todos llegan desde src/web.py (JSON de resultados/). -#}
{%- set eda = eda -%}
{%- set pr = perfiles_resumen -%}
{%- set sr = series_resumen -%}
{%- set rr = riesgo_resumen -%}
{%- set mundial = perfiles.mundial -%}
{%- set regional = perfiles.regional -%}
{%- set ips = series.ips -%}
{%- set nacional_fin = eda.nacional[-1] -%}
{%- set kw = eda.kruskal -%}
{%- set nombres_metricas = config.riesgo.nombres_metricas -%}
{%- macro figura(archivo, alt, pie) -%}
<figure class="figura">
  <button class="figura__boton" type="button" data-ampliar="figuras/{{ archivo }}" aria-label="Ampliar figura: {{ alt }}">
    <img src="figuras/{{ archivo }}" alt="{{ alt }}" loading="lazy">
  </button>
  <figcaption>{{ pie }}</figcaption>
</figure>
{%- endmacro -%}
{%- macro dato(valor, etiqueta) -%}
<div class="dato"><span class="dato__valor">{{ valor }}</span><span class="dato__etiqueta">{{ etiqueta }}</span></div>
{%- endmacro -%}
<!doctype html>
<html lang="{{ config.web.idioma }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ config.proyecto.titulo }}</title>
<meta name="description" content="Resultados de un estudio de ciencia de datos sobre la respuesta sanitaria de {{ pais }} frente al COVID-19, con datos al {{ config.fecha_corte | fecha }}.">
<meta name="author" content="{{ config.proyecto.autor }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family={{ config.web.fuente_titulos | replace(' ', '+') }}:opsz,wght@8..60,500;8..60,700&family={{ config.web.fuente_texto | replace(' ', '+') }}:wght@400;500;600&display=swap" rel="stylesheet">
<script>
  // Aplica el tema guardado antes de pintar, para evitar un parpadeo de colores.
  (function () {
    try {
      var tema = localStorage.getItem("tema");
      if (tema === "claro" || tema === "oscuro") { document.documentElement.setAttribute("data-tema", tema); }
    } catch (e) {}
  })();
</script>
<style>
  :root {
    --fondo: #FAFAF8;
    --superficie: #FFFFFF;
    --superficie-2: #F2F2EE;
    --texto: #1D1D1B;
    --texto-2: #55554F;
    --texto-3: #7A7A73;
    --borde: #E2E2DC;
    --foco: #B2182B;
    --azul: #2166AC;
    --azul-suave: #D1E5F0;
    --aviso-fondo: #FFF6E5;
    --aviso-borde: #E0A526;
    --sombra: 0 1px 2px rgba(0,0,0,.04), 0 4px 16px rgba(0,0,0,.04);
    --fuente-titulos: "{{ config.web.fuente_titulos }}", Georgia, serif;
    --fuente-texto: "{{ config.web.fuente_texto }}", system-ui, -apple-system, "Segoe UI", sans-serif;
    --ancho: 1080px;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-tema="claro"]) {
      --fondo: #141413;
      --superficie: #1D1D1B;
      --superficie-2: #262624;
      --texto: #EDEDE8;
      --texto-2: #B8B8B0;
      --texto-3: #8E8E86;
      --borde: #34342F;
      --foco: #EF6F6C;
      --azul: #7DB3E0;
      --azul-suave: #1F3347;
      --aviso-fondo: #2E2614;
      --aviso-borde: #B8861F;
      --sombra: none;
      color-scheme: dark;
    }
  }
  :root[data-tema="oscuro"] {
    --fondo: #141413;
    --superficie: #1D1D1B;
    --superficie-2: #262624;
    --texto: #EDEDE8;
    --texto-2: #B8B8B0;
    --texto-3: #8E8E86;
    --borde: #34342F;
    --foco: #EF6F6C;
    --azul: #7DB3E0;
    --azul-suave: #1F3347;
    --aviso-fondo: #2E2614;
    --aviso-borde: #B8861F;
    --sombra: none;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 64px; }
  body {
    margin: 0;
    background: var(--fondo);
    color: var(--texto);
    font-family: var(--fuente-texto);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .contenedor { max-width: var(--ancho); margin: 0 auto; padding: 0 16px; }
  h1, h2, h3 { font-family: var(--fuente-titulos); line-height: 1.2; margin: 0 0 .5em; font-weight: 700; }
  h1 { font-size: clamp(1.9rem, 4.5vw, 3rem); letter-spacing: -.01em; }
  h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
  h3 { font-size: 1.15rem; margin-top: 1.8em; font-weight: 500; }
  p { margin: 0 0 1em; max-width: 72ch; }
  a { color: var(--azul); }
  .num { font-variant-numeric: tabular-nums; }
  .foco { color: var(--foco); font-weight: 600; }

  /* Encabezado */
  .cabecera { padding: 56px 0 32px; border-bottom: 1px solid var(--borde); }
  .cabecera__antetitulo { text-transform: uppercase; letter-spacing: .08em; font-size: .78rem; color: var(--texto-3); font-weight: 600; margin-bottom: 12px; }
  .cabecera__bajada { font-size: 1.12rem; color: var(--texto-2); max-width: 62ch; }
  .cabecera__autor { font-size: .9rem; color: var(--texto-3); margin-top: 16px; }

  /* Navegación */
  .nav { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--fondo) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--borde); }
  .nav__interior { display: flex; align-items: center; gap: 8px; }
  .nav__enlaces { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; flex: 1; min-width: 0; padding: 10px 0; }
  .nav__enlaces::-webkit-scrollbar { display: none; }
  .nav__enlaces a { white-space: nowrap; text-decoration: none; color: var(--texto-2); font-size: .88rem; font-weight: 500; padding: 6px 12px; border-radius: 999px; }
  .nav__enlaces a:hover { background: var(--superficie-2); color: var(--texto); }
  .nav__enlaces a.activo { background: var(--texto); color: var(--fondo); }
  .tema { flex: none; border: 1px solid var(--borde); background: var(--superficie); color: var(--texto); border-radius: 999px; padding: 6px 12px; font: inherit; font-size: .82rem; cursor: pointer; }

  /* Secciones */
  section { padding: 56px 0 24px; border-bottom: 1px solid var(--borde); }
  .seccion__numero { font-size: .8rem; font-weight: 600; color: var(--texto-3); text-transform: uppercase; letter-spacing: .08em; }
  .entradilla { font-size: 1.05rem; color: var(--texto-2); }

  /* Hallazgos */
  .hallazgos { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 16px; margin: 32px 0 8px; }
  .hallazgo { background: var(--superficie); border: 1px solid var(--borde); border-radius: 14px; padding: 20px; box-shadow: var(--sombra); display: flex; flex-direction: column; gap: 6px; }
  .hallazgo__cifra { font-family: var(--fuente-titulos); font-size: 2.3rem; font-weight: 700; color: var(--foco); line-height: 1; font-variant-numeric: tabular-nums; }
  .hallazgo__unidad { font-size: .8rem; color: var(--texto-3); }
  .hallazgo__titulo { font-weight: 600; margin-top: 8px; }
  .hallazgo__texto { font-size: .9rem; color: var(--texto-2); margin: 0; }

  /* Datos destacados */
  .datos { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 24px 0; }
  .dato { background: var(--superficie-2); border-radius: 10px; padding: 14px 16px; display: flex; flex-direction: column; }
  .dato__valor { font-size: 1.45rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .dato__etiqueta { font-size: .8rem; color: var(--texto-3); }

  /* Figuras */
  .figuras { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 20px; margin: 24px 0; }
  .figura { margin: 0; }
  .figura__boton { display: block; width: 100%; padding: 12px; background: #FFFFFF; border: 1px solid var(--borde); border-radius: 12px; cursor: zoom-in; }
  .figura__boton:focus-visible { outline: 2px solid var(--azul); outline-offset: 2px; }
  .figura img { display: block; width: 100%; height: auto; }
  .figura figcaption { font-size: .85rem; color: var(--texto-3); margin-top: 8px; }
  .figura--ancha { grid-column: 1 / -1; }

  /* Tablas */
  .tabla-envoltura { overflow-x: auto; margin: 16px 0 24px; border: 1px solid var(--borde); border-radius: 12px; background: var(--superficie); }
  table { border-collapse: collapse; width: 100%; font-size: .9rem; }
  th, td { padding: 9px 12px; text-align: left; border-bottom: 1px solid var(--borde); vertical-align: top; }
  th { font-weight: 600; color: var(--texto-2); background: var(--superficie-2); white-space: nowrap; }
  tr:last-child td { border-bottom: 0; }
  td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  tr.resaltada td { background: color-mix(in srgb, var(--azul) 9%, transparent); font-weight: 600; }
  tr.foco td { background: color-mix(in srgb, var(--foco) 9%, transparent); }
  .ic { color: var(--texto-3); font-size: .8rem; }

  /* Avisos */
  .aviso { border-left: 4px solid var(--aviso-borde); background: var(--aviso-fondo); padding: 14px 18px; border-radius: 0 10px 10px 0; margin: 20px 0; font-size: .95rem; }
  .aviso p { margin: 0; }
  .aviso strong { display: block; margin-bottom: 4px; }

  /* Simulador */
  .simulador { background: var(--superficie); border: 1px solid var(--borde); border-radius: 14px; padding: 24px; margin: 24px 0; box-shadow: var(--sombra); }
  .simulador__control { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; margin: 12px 0 20px; }
  .simulador__control label { font-weight: 600; }
  .simulador input[type="range"] { flex: 1 1 220px; accent-color: var(--azul); }
  .simulador__salida { font-variant-numeric: tabular-nums; font-weight: 600; min-width: 5ch; }
  .barras { display: flex; flex-direction: column; gap: 6px; position: relative; }
  .barra { display: grid; grid-template-columns: 96px 1fr 52px; gap: 8px; align-items: center; font-size: .85rem; }
  .barra__pista { position: relative; height: 18px; background: var(--superficie-2); border-radius: 4px; }
  .barra__relleno { position: absolute; inset: 0 auto 0 0; background: var(--texto-3); border-radius: 4px; opacity: .55; transition: width .2s ease; }
  .barra--foco .barra__relleno { background: var(--foco); opacity: 1; }
  .barra--foco { font-weight: 600; }
  .barra__mediana { position: absolute; top: -4px; bottom: -4px; width: 0; border-left: 2px dashed var(--texto-2); }
  .barra__valor { text-align: right; font-variant-numeric: tabular-nums; }
  .simulador__resumen { margin-top: 18px; font-size: .95rem; color: var(--texto-2); }

  /* Conclusiones y pie */
  .conclusiones li { margin-bottom: .8em; max-width: 72ch; }
  .pie { padding: 40px 0 56px; font-size: .85rem; color: var(--texto-3); }
  .pie p { max-width: none; }

  /* Visor de figuras */
  .visor { border: 0; padding: 0; background: transparent; max-width: 96vw; max-height: 94vh; }
  .visor::backdrop { background: rgba(0,0,0,.82); }
  .visor img { display: block; max-width: 96vw; max-height: 88vh; background: #FFFFFF; border-radius: 8px; padding: 8px; }
  .visor__cerrar { position: fixed; top: 12px; right: 16px; background: #FFFFFF; color: #1D1D1B; border: 0; border-radius: 999px; padding: 8px 14px; font: inherit; font-weight: 600; cursor: pointer; }

  @media (max-width: 560px) {
    body { font-size: 15px; }
    .cabecera { padding: 36px 0 24px; }
    section { padding: 40px 0 16px; }
    .barra { grid-template-columns: 76px 1fr 44px; font-size: .8rem; }
    .simulador { padding: 16px; }
    th, td { padding: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .barra__relleno { transition: none; }
  }
</style>
</head>
<body>

<header class="cabecera">
  <div class="contenedor">
    <div class="cabecera__antetitulo">Ciencia de datos · datos al {{ config.fecha_corte | fecha }}</div>
    <h1>{{ config.proyecto.titulo }}</h1>
    <p class="cabecera__bajada">
      Qué tan grave fue la primera ola en {{ pais }}, con qué países se parece su perfil, cuánta presión soportó su
      sistema hospitalario y si era posible anticipar qué municipios tendrían letalidad alta.
    </p>
    <p class="cabecera__autor">{{ config.proyecto.autor }} · {{ config.proyecto.carrera }} · {{ config.proyecto.institucion }}</p>
  </div>
</header>

<nav class="nav" aria-label="Secciones">
  <div class="contenedor nav__interior">
    <div class="nav__enlaces">
      <a href="#resumen">Resumen</a>
      <a href="#contexto">Contexto</a>
      <a href="#perfiles">Perfiles</a>
      <a href="#pronostico">Pronóstico</a>
      <a href="#presion">Presión sanitaria</a>
      <a href="#riesgo">Riesgo municipal</a>
      <a href="#conclusiones">Conclusiones</a>
    </div>
    <button class="tema" type="button" id="boton-tema" aria-label="Cambiar entre tema claro y oscuro">Tema</button>
  </div>
</nav>

<main>

<!-- ============================== RESUMEN ============================== -->
<section id="resumen">
  <div class="contenedor">
    <div class="seccion__numero">Resumen</div>
    <h2>Cuatro hallazgos clave</h2>
    <div class="hallazgos">
      {% for h in hallazgos %}
      <article class="hallazgo">
        <div class="hallazgo__cifra">{{ h.cifra }}</div>
        <div class="hallazgo__unidad">{{ h.unidad }}</div>
        <div class="hallazgo__titulo">{{ h.titulo }}</div>
        <p class="hallazgo__texto">{{ h.texto }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ============================== CONTEXTO ============================== -->
<section id="contexto">
  <div class="contenedor">
    <div class="seccion__numero">Contexto</div>
    <h2>La primera ola en cifras</h2>
    <p class="entradilla">
      En la semana epidemiológica {{ eda.semana_fin }}, los {{ calidad.municipios.municipios | num }} municipios con casos
      sumaban {{ nacional_fin.confirmados | num }} confirmados y {{ nacional_fin.fallecidos | num }} fallecidos.
    </p>
    <div class="datos">
      {{ dato(nacional_fin.confirmados | num, "confirmados acumulados (SE " ~ eda.semana_fin ~ ")") }}
      {{ dato(nacional_fin.fallecidos | num, "fallecidos acumulados") }}
      {{ dato(nacional_fin.letalidad | pct(2), "letalidad nacional") }}
      {{ dato(eda.distribucion.porcentaje_casos_top10 | pct(0), "de los casos en 10 municipios") }}
    </div>

    <div class="figuras">
      {{ figura("eda_comparacion_indicadores.png", "Casos por millón, fallecidos por millón y letalidad de " ~ pais ~ " y países vecinos",
         pais ~ " ocupa el puesto " ~ eda.internacional.puesto_foco.muertes_por_millon ~ ".º en fallecidos por millón y el " ~ eda.internacional.puesto_foco.casos_por_millon ~ ".º en casos por millón entre " ~ eda.internacional.puesto_foco.total_paises ~ " países.") }}
      {{ figura("eda_comparacion_casos.png", "Casos diarios por millón con media móvil en los países comparados",
         "Pico de " ~ pais ~ ": " ~ (eda.internacional.pico_foco_mm.casos_millon_mm | num(1)) ~ " casos diarios por millón el " ~ (eda.internacional.pico_foco_mm.fecha | fecha) ~ ".") }}
    </div>

    <h3>Diferencias entre departamentos</h3>
    <p>
      La letalidad de los municipios con {{ kw.minimo_casos | num }} casos o más difiere entre departamentos
      (Kruskal-Wallis H&nbsp;=&nbsp;{{ kw.H | num(1) }}, gl&nbsp;=&nbsp;{{ kw.gl }}, {{ kw.p | valor_p }};
      ε²&nbsp;=&nbsp;{{ kw.epsilon2 | num(2) }}). La mediana más alta es la de {{ kw.detalle[0].departamento | dep }}
      ({{ kw.detalle[0].mediana | pct }}) y la más baja la de {{ kw.detalle[-1].departamento | dep }} ({{ kw.detalle[-1].mediana | pct }}).
    </p>
    <div class="figuras">
      {{ figura("eda_departamentos.png", "Confirmados y letalidad por departamento", "Letalidad agregada por departamento frente a la nacional (" ~ (nacional_fin.letalidad | pct(2)) ~ ").") }}
      {{ figura("eda_boxplot_letalidad.png", "Letalidad municipal por departamento", "Cada punto es un municipio. Se excluyen de la prueba los departamentos con un solo municipio.") }}
    </div>
    {% if calidad.municipios.semanas_faltantes %}
    <div class="aviso">
      <strong>Calidad de los datos</strong>
      <p>
        Falta la semana {{ calidad.municipios.semanas_faltantes | join(", ") }} en los datos municipales. Hay
        {{ calidad.municipios.descensos_acumulados.confirmados }} descensos de confirmados acumulados y
        {{ calidad.municipios.descensos_acumulados.fallecidos }} de fallecidos (correcciones de la fuente), que se informan sin modificarse.
      </p>
    </div>
    {% endif %}
  </div>
</section>

<!-- ============================== MODELO 1 ============================== -->
<section id="perfiles">
  <div class="contenedor">
    <div class="seccion__numero">Modelo 1 · k-means</div>
    <h2>¿A qué países se parece {{ pais }}?</h2>
    <p class="entradilla">
      Con {{ perfiles.variables | length }} indicadores estandarizados, {{ mundial.n_paises }} países se agrupan en
      {{ mundial.k }} perfiles. {{ pais }} cae en el grupo «{{ pr.grupo.nombre }}», de {{ pr.grupo.tamano }} países.
    </p>
    <div class="datos">
      {{ dato(mundial.k, "grupos (k por silueta)") }}
      {{ dato(mundial.silueta | num(3), "silueta media") }}
      {{ dato(mundial.ari_ward | num(2), "ARI frente a Ward") }}
      {{ dato(mundial.estabilidad.procedimiento.media | num(2), "ARI medio con otras semillas") }}
    </div>
    <div class="figuras">
      {{ figura("perfiles_pca_mundial.png", "Países en el plano de dos componentes principales, coloreados por grupo", "Los grupos se forman en las " ~ (perfiles.variables | length) ~ " dimensiones; el plano muestra el " ~ (((mundial.pca.varianza_explicada[0] + mundial.pca.varianza_explicada[1]) * 100) | pct(0)) ~ " de la varianza.") }}
      {{ figura("perfiles_grupos.png", "Perfil estandarizado medio de cada grupo", "Valores en desviaciones estándar respecto de la media de los " ~ mundial.n_paises ~ " países.") }}
    </div>

    <h3>Grupos de la muestra mundial</h3>
    <div class="tabla-envoltura">
      <table>
        <thead><tr><th>Grupo</th><th>Perfil</th><th class="n">Países</th><th>Integrantes</th></tr></thead>
        <tbody>
          {% for g in mundial.grupos %}
          <tr{% if g.contiene_foco %} class="foco"{% endif %}>
            <td>G{{ g.grupo }}</td>
            <td>{{ g.nombre }}</td>
            <td class="n">{{ g.tamano }}</td>
            <td>{{ g.miembros_es | join(", ") }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <h3>Rasgos de {{ pais }} y países más parecidos</h3>
    <p>
      Sus rasgos más alejados de la media mundial son
      {% for e in pr.extremos %}{{ e.nombre | lower }} ({{ "+" if e.z > 0 else "" }}{{ e.z | num(1) }}&nbsp;DE){{ ", " if not loop.last else "." }}{% endfor %}
      En {{ mundial.estabilidad.procedimiento.corridas }} corridas con semillas distintas, {{ pr.nucleo | length }} países lo
      acompañan siempre o casi siempre{% if pr.limite %}; {% for l in pr.limite %}{{ l.pais | pais }} ({{ (l.proporcion * 100) | pct(0) }}){{ ", " if not loop.last else "" }}{% endfor %} están en el límite entre grupos{% endif %}.
    </p>
    <div class="tabla-envoltura">
      <table>
        <thead><tr><th>Puesto</th><th>País</th><th class="n">Distancia euclidiana</th></tr></thead>
        <tbody>
          {% for v in mundial.vecinos_foco %}
          <tr><td>{{ loop.index }}</td><td>{{ v.nombre }}</td><td class="n">{{ v.distancia | num(2) }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {% if pr.regional_debil %}
    <div class="aviso">
      <strong>La muestra regional no tiene una estructura de grupos clara</strong>
      <p>
        Con solo {{ regional.n_paises }} países, la mejor partición (k&nbsp;=&nbsp;{{ regional.k }}) tiene silueta
        {{ regional.silueta | num(2) }} (menor que {{ pr.umbral_silueta_debil | num(2) }}) y ARI frente a Ward de {{ regional.ari_ward | num(2) }}.
        Separa a {% for g in regional.grupos if g.contiene_foco %}{{ g.miembros_es | join(", ") }}{% endfor %} del resto,
        pero esa división no debe tomarse como concluyente.
      </p>
    </div>
    {% endif %}
    <div class="figuras">
      {{ figura("perfiles_silueta.png", "Silueta media según el número de grupos", "En la muestra mundial se exige k ≥ " ~ mundial.k_minimo_aceptado ~ " para evitar la partición trivial.") }}
      {{ figura("perfiles_regional.png", "Países sudamericanos en el plano de dos componentes principales", "Muestra regional: " ~ regional.n_paises ~ " países.") }}
    </div>
  </div>
</section>

<!-- ============================== MODELO 2a ============================== -->
<section id="pronostico">
  <div class="contenedor">
    <div class="seccion__numero">Modelo 2 · pronóstico</div>
    <h2>Casos semanales: ¿qué tan predecibles eran?</h2>
    <p class="entradilla">
      Se compararon {{ series.metricas | length }} modelos pronosticando {{ series.horizonte }} semanas desde
      {{ series.cortes }} cortes sucesivos. El pico semanal fue de {{ series.serie.casos_pico | num }} casos
      (semana que cerró el {{ series.serie.fecha_pico | fecha }}).
    </p>
    <div class="tabla-envoltura">
      <table>
        <thead><tr><th>Modelo</th><th class="n">RMSE</th><th class="n">MAE</th><th class="n">MAPE</th><th class="n">R²</th><th class="n">MASE</th><th class="n">MAE / ingenuo</th></tr></thead>
        <tbody>
          {% for m in series.metricas %}
          <tr{% if m.modelo == series.mejor_modelo %} class="resaltada"{% endif %}>
            <td>{{ m.nombre }}</td>
            <td class="n">{{ m.RMSE | num }}</td>
            <td class="n">{{ m.MAE | num }}</td>
            <td class="n">{{ m.MAPE | pct(1) }}</td>
            <td class="n">{{ m.R2 | num(2) }}</td>
            <td class="n">{{ m.MASE | num(2) }}</td>
            <td class="n">{{ m.MAE_relativo_ingenuo | num(2) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p>
      {{ sr.mejor.nombre }} tuvo el menor RMSE y redujo el error absoluto medio del modelo ingenuo en
      {{ sr.mejora_ingenuo_pct | pct(0) }}.
    </p>
    {% if sr.todos_r2_negativos %}
    <div class="aviso">
      <strong>Todos los modelos tienen R² negativo</strong>
      <p>
        Ninguno pronostica mejor que la media de las semanas evaluadas (R² de {{ sr.mejor.nombre }}: {{ sr.mejor.R2 | num(2) }}),
        porque ninguno anticipa el pico ni la caída posterior. El MASE supera la unidad en todos los casos porque compara con el error
        de un paso dentro del entrenamiento; la columna «MAE / ingenuo» compara con el modelo ingenuo en las mismas semanas.
      </p>
    </div>
    {% endif %}
    {% if sr.horizontes_peor_que_ingenuo %}
    <div class="aviso">
      <strong>La ventaja se pierde a más largo plazo</strong>
      <p>
        A {{ sr.horizontes_peor_que_ingenuo | join(" y ") }} semana(s), {{ sr.mejor.nombre }} tiene un RMSE mayor que el del modelo ingenuo.
      </p>
    </div>
    {% endif %}
    <div class="figuras">
      {{ figura("series_validacion.png", "Casos semanales observados y pronósticos desde cada corte", "Cada línea azul es un pronóstico a " ~ series.horizonte ~ " semanas hecho solo con los datos anteriores.") }}
      {{ figura("series_metricas.png", "RMSE por modelo y según el horizonte", "El error crece con el horizonte en todos los modelos.") }}
    </div>

    <h3>Proyección posterior al corte</h3>
    <div class="tabla-envoltura">
      <table>
        <thead><tr><th>Semana que cierra</th><th class="n">{{ series.proyeccion.nombre }}</th><th class="n">Intervalo {{ config.series.niveles_intervalo[0] }}&nbsp;%</th><th class="n">Intervalo {{ config.series.niveles_intervalo[1] }}&nbsp;%</th><th class="n">ARIMA({{ series.proyeccion_arima.orden | join(",") }})</th></tr></thead>
        <tbody>
          {% for s in series.proyeccion.semanas %}
          {% set a = series.proyeccion_arima.semanas[loop.index0] %}
          {% set n1 = config.series.niveles_intervalo[0] %}{% set n2 = config.series.niveles_intervalo[1] %}
          <tr>
            <td>{{ s.fecha | fecha }}</td>
            <td class="n">{{ s.pronostico | num }}</td>
            <td class="n">{{ s["inferior_" ~ n1] | num }} – {{ s["superior_" ~ n1] | num }}</td>
            <td class="n">{{ s["inferior_" ~ n2] | num }} – {{ s["superior_" ~ n2] | num }}</td>
            <td class="n">{{ a.pronostico | num }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="aviso">
      <strong>Intervalos aproximados</strong>
      <p>
        Los intervalos de {{ series.proyeccion.nombre }} salen de los errores reales de la validación ({{ series.cortes }} por horizonte),
        con el límite inferior truncado en cero. Son aproximados y más anchos que los de ARIMA, que dependen de los supuestos del modelo.
      </p>
    </div>
    <div class="figuras">
      {{ figura("series_proyeccion.png", "Proyección de casos semanales con intervalos", "Izquierda: intervalos empíricos. Derecha: intervalos de ARIMA.") }}
    </div>
  </div>
</section>

<!-- ============================== MODELO 2b ============================== -->
<section id="presion">
  <div class="contenedor">
    <div class="seccion__numero">Modelo 2 · índice de presión sanitaria</div>
    <h2>¿Cuánta presión soportaron los hospitales?</h2>
    <p class="entradilla">
      El índice de presión sanitaria (IPS) divide los casos nuevos de {{ ips.ventana_dias }} días entre las camas hospitalarias
      {{ ips.tipo_camas }}. El de {{ pais }} llegó a {{ sr.ips_foco.ips_pico | num(2) }} el {{ sr.ips_foco.fecha_pico | fecha }},
      con {{ sr.ips_foco.camas | num }} camas: el {{ sr.ips_puesto }}.º valor más alto de {{ ips.paises | length }} países.
    </p>
    <div class="figuras">
      {{ figura("series_ips.png", "Índice de presión sanitaria diario de los países comparados", "Línea discontinua: mediana del IPS pico de los otros países (" ~ (ips.mediana_ips_pico_otros | num(2)) ~ ").") }}
      {{ figura("series_escenarios.png", "IPS pico de " ~ pais ~ " con más camas", "Mismos casos del pico; solo cambia el número de camas.") }}
    </div>
    <div class="tabla-envoltura">
      <table>
        <thead><tr><th>País</th><th class="n">Camas totales</th><th class="n">IPS pico</th><th>Fecha del pico</th><th class="n">IPS al corte</th></tr></thead>
        <tbody>
          {% for p in sr.ips_paises %}
          <tr{% if p.es_foco %} class="foco"{% endif %}>
            <td>{{ p.nombre }}</td>
            <td class="n">{{ p.camas | num }}</td>
            <td class="n">{{ p.ips_pico | num(2) }}</td>
            <td>{{ p.fecha_pico | fecha }}</td>
            <td class="n">{{ p.ips_corte | num(2) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="simulador" id="simulador">
      <h3 style="margin-top:0">Simulador: ¿cuántas camas más hacían falta?</h3>
      <p>Mueva el control para sumar camas hospitalarias a las {{ sr.ips_foco.camas | num }} de {{ pais }} y ver cómo cambia su IPS en el pico frente a los otros países.</p>
      <div class="simulador__control">
        <label for="control-camas">Camas adicionales</label>
        <input type="range" id="control-camas" min="0" max="{{ simulador.maxPct }}" step="{{ simulador.pasoPct }}" value="0">
        <output class="simulador__salida" id="salida-pct" for="control-camas"></output>
      </div>
      <div class="barras" id="barras" aria-live="polite"></div>
      <p class="simulador__resumen" id="resumen-simulador"></p>
      <noscript><p>El simulador necesita JavaScript. Con +{{ ips.incremento_necesario_pct | pct(1) }} de camas ({{ ips.camas_necesarias | num }} en total), el IPS pico iguala la mediana regional.</p></noscript>
    </div>
    <div class="aviso">
      <strong>Camas totales, no de terapia intensiva</strong>
      <p>Our World in Data no publica camas de terapia intensiva para la mayoría de los países de la región. El IPS mide presión relativa sobre el sistema hospitalario, no la ocupación real de las unidades de cuidados intensivos.</p>
    </div>
  </div>
</section>

<!-- ============================== MODELO 3 ============================== -->
<section id="riesgo">
  <div class="contenedor">
    <div class="seccion__numero">Modelo 3 · clasificación</div>
    <h2>¿Se podía anticipar qué municipios tendrían letalidad alta?</h2>
    <p class="entradilla">
      Entre los {{ riesgo.muestra.municipios }} municipios con {{ riesgo.muestra.min_casos }} casos o más en la semana {{ riesgo.muestra.semana_fin }},
      {{ riesgo.muestra.altos }} terminaron con letalidad de {{ riesgo.muestra.umbral_letalidad | pct(1) }} o más. Los modelos usan solo datos
      de la semana {{ riesgo.muestra.semana_referencia }}.
    </p>
    {% if riesgo.decision.persistencia_principal %}
    <div class="aviso">
      <strong>Resultado principal: la regla de persistencia iguala o supera a todos los modelos</strong>
      <p>
        Suponer que la letalidad de la semana {{ riesgo.muestra.semana_referencia }} se mantiene da un F1 de
        {{ rr.persistencia.f1.media | num(2) }} y un AUC de {{ rr.persistencia.roc_auc.media | num(2) }}. El mejor modelo
        ({{ rr.mejor.nombre | lower }} con el conjunto {{ rr.mejor.conjunto }}) logra {{ rr.mejor.f1.media | num(2) }} y
        {{ rr.mejor.roc_auc.media | num(2) }}; la diferencia de F1 es {{ riesgo.diferencia_mejor_vs_persistencia.f1.media | num(2) }}
        (IC {{ (riesgo.validacion.nivel_confianza * 100) | pct(0) }}: {{ riesgo.diferencia_mejor_vs_persistencia.f1.ic_inf | num(2) }} a
        {{ riesgo.diferencia_mejor_vs_persistencia.f1.ic_sup | num(2) }}).
      </p>
    </div>
    {% endif %}
    <div class="tabla-envoltura">
      <table>
        <thead>
          <tr><th>Modelo</th><th>Variables</th>
          {% for clave in ["f1", "roc_auc", "accuracy", "precision", "recall"] %}<th class="n">{{ nombres_metricas[clave] }}</th>{% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for f in rr.tabla %}
          <tr{% if f.modelo == "persistencia" %} class="resaltada"{% endif %}>
            <td>{{ f.nombre }}</td>
            <td>{{ "—" if f.conjunto == "-" or f.modelo == "mayoritaria" else f.conjunto }}</td>
            {% for clave in ["f1", "roc_auc", "accuracy", "precision", "recall"] %}
            <td class="n">{{ f[clave].media | num(2) }}<br><span class="ic">{{ f[clave].ic_inf | num(2) }}–{{ f[clave].ic_sup | num(2) }}</span></td>
            {% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="ic">
      Validación cruzada estratificada {{ riesgo.validacion.pliegues }} × {{ riesgo.validacion.repeticiones }}; debajo de cada media, IC
      {{ (riesgo.validacion.nivel_confianza * 100) | pct(0) }} ({{ riesgo.validacion.metodo_ic }}).
      A = tamaño del brote + departamento; B = A + letalidad y fallecidos de la semana {{ riesgo.muestra.semana_referencia }}.
    </p>
    <div class="figuras">
      {{ figura("riesgo_persistencia.png", "Letalidad municipal en la semana de referencia frente a la semana final", rr.estables ~ " de " ~ riesgo.muestra.municipios ~ " municipios quedan del mismo lado del umbral.") }}
      {{ figura("riesgo_metricas.png", "F1 y AUC con intervalos de confianza por modelo", "La banda azul es el intervalo de la persistencia.") }}
      {{ figura("riesgo_confusion.png", "Matrices de confusión medias de la persistencia y del mejor modelo", "En número de municipios, promedio de " ~ riesgo.validacion.repeticiones ~ " repeticiones.") }}
      {{ figura("riesgo_importancia.png", "Importancia de las variables por permutación", rr.importancia_principal.nombre ~ " concentra casi toda la capacidad predictiva (caída del AUC: " ~ (rr.importancia_principal.media | num(2)) ~ ").") }}
    </div>
  </div>
</section>

<!-- ============================== CONCLUSIONES ============================== -->
<section id="conclusiones">
  <div class="contenedor">
    <div class="seccion__numero">Conclusiones</div>
    <h2>Qué dicen los datos</h2>
    <ul class="conclusiones">
      <li>
        <strong>{{ hallazgos[0].titulo }}.</strong>
        {{ pais }} registró {{ foco_indicadores.muertes_por_millon | num }} fallecidos por millón con una letalidad de
        {{ foco_indicadores.letalidad | pct }}{% if hallazgos[0].subregistro %}, lo que sugiere un subregistro importante de casos{% endif %}.
      </li>
      <li>
        <strong>Su perfil se parece al de otros países de la región.</strong>
        Lo que más lo distingue de la media mundial es
        {% for e in pr.extremos %}{{ e.nombre | lower }} ({{ "+" if e.z > 0 else "" }}{{ e.z | num(1) }}&nbsp;DE){{ ", " if not loop.last else "" }}{% endfor %};
        comparte el grupo «{{ pr.grupo.nombre }}» con {{ pr.grupo.tamano - 1 }} países, y su vecino más cercano es {{ mundial.vecinos_foco[0].nombre }}.
      </li>
      <li>
        <strong>La capacidad hospitalaria fue un cuello de botella.</strong>
        En el pico hubo {{ sr.ips_foco.ips_pico | num(2) }} casos recientes por cama; con {{ ips.camas_adicionales | num }} camas más
        (+{{ ips.incremento_necesario_pct | pct(1) }}) la presión habría igualado la mediana regional.
      </li>
      <li>
        <strong>Los pronósticos a un mes son poco fiables cerca de un pico.</strong>
        El mejor modelo ({{ sr.mejor.nombre }}) mejora al ingenuo en {{ sr.mejora_ingenuo_pct | pct(0) }}, pero su R² en validación es
        {{ sr.mejor.R2 | num(2) }}.
      </li>
      <li>
        <strong>Para vigilar municipios, la letalidad reciente es la mejor señal.</strong>
        Una regla simple (letalidad de la semana {{ riesgo.muestra.semana_referencia }} ≥ {{ riesgo.muestra.umbral_letalidad | pct(1) }})
        rinde tanto como un bosque aleatorio (F1 {{ rr.persistencia.f1.media | num(2) }} frente a {{ rr.mejor.f1.media | num(2) }}).
      </li>
    </ul>
  </div>
</section>

</main>

<footer class="pie">
  <div class="contenedor">
    <p>
      Fuentes: Our World in Data, <i>COVID-19 dataset</i> (CC BY 4.0), datos al {{ config.fecha_corte | fecha }};
      datos municipales de COVID-19 de {{ pais }}, semanas epidemiológicas {{ config.municipios.semana_inicio }} a {{ config.municipios.semana_fin }} de {{ config.fecha_corte[:4] }}.
    </p>
    <p>
      Página generada automáticamente por <code>src/web.py</code> a partir de los resultados del análisis. Código bajo licencia MIT.
      {{ config.proyecto.autor }} · {{ config.proyecto.institucion }}.
    </p>
  </div>
</footer>

<dialog class="visor" id="visor" aria-label="Figura ampliada">
  <button class="visor__cerrar" type="button" id="visor-cerrar">Cerrar ✕</button>
  <img id="visor-imagen" src="" alt="">
</dialog>

<script type="application/json" id="datos-simulador">{{ simulador | tojson }}</script>
<script>
(function () {
  "use strict";

  /* ---------- Tema claro / oscuro ---------- */
  var raiz = document.documentElement;
  var botonTema = document.getElementById("boton-tema");
  function temaEfectivo() {
    var elegido = raiz.getAttribute("data-tema");
    if (elegido) { return elegido; }
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "oscuro" : "claro";
  }
  function rotularTema() {
    botonTema.textContent = temaEfectivo() === "oscuro" ? "☀ Claro" : "☾ Oscuro";
  }
  botonTema.addEventListener("click", function () {
    var nuevo = temaEfectivo() === "oscuro" ? "claro" : "oscuro";
    raiz.setAttribute("data-tema", nuevo);
    try { localStorage.setItem("tema", nuevo); } catch (e) {}
    rotularTema();
  });
  rotularTema();

  /* ---------- Navegación: resalta la sección visible ---------- */
  var enlaces = Array.prototype.slice.call(document.querySelectorAll(".nav__enlaces a"));
  if ("IntersectionObserver" in window) {
    var observador = new IntersectionObserver(function (entradas) {
      entradas.forEach(function (entrada) {
        if (!entrada.isIntersecting) { return; }
        enlaces.forEach(function (enlace) {
          var activo = enlace.getAttribute("href") === "#" + entrada.target.id;
          enlace.classList.toggle("activo", activo);
          if (activo && enlace.scrollIntoView) { enlace.scrollIntoView({ block: "nearest", inline: "nearest" }); }
        });
      });
    }, { rootMargin: "-15% 0px -80% 0px" });
    document.querySelectorAll("main section").forEach(function (s) { observador.observe(s); });
  }

  /* ---------- Visor de figuras ---------- */
  var visor = document.getElementById("visor");
  var imagenVisor = document.getElementById("visor-imagen");
  document.querySelectorAll("[data-ampliar]").forEach(function (boton) {
    boton.addEventListener("click", function () {
      var imagen = boton.querySelector("img");
      imagenVisor.src = boton.getAttribute("data-ampliar");
      imagenVisor.alt = imagen ? imagen.alt : "";
      if (visor.showModal) { visor.showModal(); } else { window.open(imagenVisor.src, "_blank"); }
    });
  });
  document.getElementById("visor-cerrar").addEventListener("click", function () { visor.close(); });
  visor.addEventListener("click", function (evento) { if (evento.target === visor) { visor.close(); } });

  /* ---------- Simulador de camas ---------- */
  var datos = JSON.parse(document.getElementById("datos-simulador").textContent);
  var control = document.getElementById("control-camas");
  var salidaPct = document.getElementById("salida-pct");
  var contenedorBarras = document.getElementById("barras");
  var resumen = document.getElementById("resumen-simulador");

  function formatear(valor, decimales) {
    var partes = valor.toFixed(decimales).split(".");
    partes[0] = partes[0].replace(/\B(?=(\d{3})+(?!\d))/g, " ");
    return partes.join(",");
  }

  var maximoEscala = Math.max.apply(null, datos.otros.map(function (o) { return o.ips; }).concat([datos.casos14 / datos.camas])) * 1.05;

  function dibujar() {
    var pct = Number(control.value);
    var camas = datos.camas * (1 + pct / 100);
    var ipsFoco = datos.casos14 / camas;
    salidaPct.textContent = "+" + formatear(pct, 0) + " %";
    var filas = datos.otros.map(function (o) { return { nombre: o.nombre, ips: o.ips, foco: false }; });
    filas.push({ nombre: datos.pais, ips: ipsFoco, foco: true });
    filas.sort(function (a, b) { return b.ips - a.ips; });
    var posicionMediana = (datos.mediana / maximoEscala) * 100;
    contenedorBarras.innerHTML = "";
    filas.forEach(function (fila) {
      var div = document.createElement("div");
      div.className = "barra" + (fila.foco ? " barra--foco" : "");
      var ancho = Math.min(fila.ips / maximoEscala * 100, 100);
      div.innerHTML =
        '<span></span>' +
        '<span class="barra__pista"><span class="barra__relleno" style="width:' + ancho + '%"></span>' +
        '<span class="barra__mediana" style="left:' + posicionMediana + '%"></span></span>' +
        '<span class="barra__valor">' + formatear(fila.ips, 2) + '</span>';
      div.firstChild.textContent = fila.nombre;
      contenedorBarras.appendChild(div);
    });
    var puesto = filas.findIndex(function (f) { return f.foco; }) + 1;
    var comparacion = ipsFoco <= datos.mediana ? "por debajo o igual a" : "por encima de";
    resumen.textContent =
      "Con " + formatear(Math.round(camas), 0) + " camas (" + formatear(Math.round(camas - datos.camas), 0) + " adicionales), el IPS pico de " +
      datos.pais + " sería " + formatear(ipsFoco, 2) + ": " + comparacion + " la mediana de los otros países (" +
      formatear(datos.mediana, 2) + ", línea discontinua) y el puesto " + puesto + " de " + filas.length + ".";
  }
  control.addEventListener("input", dibujar);
  dibujar();
})();
</script>
</body>
</html>
